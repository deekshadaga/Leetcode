class Solution {
public:
    int minSwaps(vector<vector<int>>& grid) {
        int n = grid.size();
        vector<int> trailingZeros(n);
        
        // Count trailing zeros for each row
        for(int i = 0; i < n; i++){
            int count = 0;
            for(int j = n-1; j >= 0 && grid[i][j] == 0; j--){
                count++;
            }
            trailingZeros[i] = count;
        }
        
        int swaps = 0;
        
        // For each position, find a row with enough trailing zeros
        for(int i = 0; i < n; i++){
            int required = n - i - 1;
            
            if(trailingZeros[i] >= required){
                continue;  // Current row is already good
            }
            
            // Find next row with enough trailing zeros
            int j = i + 1;
            while(j < n && trailingZeros[j] < required){
                j++;
            }
            
            if(j == n){
                return -1;  // No valid arrangement exists
            }
            
            // Bubble up row j to position i
            while(j > i){
                swap(trailingZeros[j], trailingZeros[j-1]);
                swaps++;
                j--;
            }
        }
        
        return swaps;
    }
};
