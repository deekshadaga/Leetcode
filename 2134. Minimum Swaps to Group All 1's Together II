class Solution {
public:
    int minSwaps(vector<int>& nums) {
        int totalOnes=0,n=nums.size();
        for(int i=0;i<n;i++){
            if(nums[i]==1) totalOnes++;
        }
        if (totalOnes == 0 || totalOnes == nums.size()) {
            return 0;
        }
        int countOne=0;
        for(int i=0;i<totalOnes;i++){
            if(nums[i]==1) countOne++;
        }
        int maxOne=countOne;
        for(int i=1;i<n;i++){
            if(nums[i-1]==1) countOne--;
            if(nums[(i+totalOnes-1)%n]==1) countOne++;
            maxOne = max(maxOne,countOne);
        }
        return (totalOnes-maxOne);
    }
};
