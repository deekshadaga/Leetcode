class Solution {
public:
    int minTime(int n, vector<vector<int>>& edges) {
        unordered_map<int,vector<pair<int,pair<int,int>>>> mp;
        for(auto it: edges){
            mp[it[0]].push_back({it[1],{it[2],it[3]}});
        }
        priority_queue<pair<int,int>, vector<pair<int,int>>,greater<pair<int,int>>> pq;
        vector<int> time(n,1e9);
        pq.push({0,0});
        while(!pq.empty()){
            int currTime = pq.top().first;
            int currNode = pq.top().second;
            pq.pop();
            if(time[currNode] <= currTime) continue;
            time[currNode] = currTime;
            for(auto it : mp[currNode]){
                int nextNode = it.first;
                int start = it.second.first;
                int end = it.second.second;
                int t = currTime;
                if(t > end) continue;
                if(t < start) t = start;
                t++;
                if(t<time[nextNode]){
                    pq.push({t,nextNode});
                }
            }
        }
        return time[n - 1] == 1e9 ? -1 : time[n - 1];
    }
};
