class Solution {
public:
    int longestBalanced(vector<int>& nums) {
        int maxLength=0;
        for(int i=0;i<nums.size()-1;i++){
            set<int> odd;
            set<int> even;
            for(int j=i;j<nums.size();j++){
                if(nums[j]%2 == 0)
                    even.insert(nums[j]);
                else
                    odd.insert(nums[j]);
                if(even.size() == odd.size()) maxLength = max(maxLength, j-i+1);
            }
        }
        return maxLength;
    }
};
